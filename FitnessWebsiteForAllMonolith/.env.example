# PUBLIC NOTE:
# Do not commit production secrets. These are sample variables required by the app.
# The orchestrator will set actual values in .env at deployment time.

# Base URL of the backend API (e.g., https://api.fitness-site.example.com or http://localhost:8000)
REACT_APP_API_BASE_URL=http://localhost:8000/api

# Optional: WebSocket base for real-time notifications (unused if not available)
REACT_APP_WS_BASE_URL=ws://localhost:8000/ws

# Site URL for auth redirect links (e.g., for magic link or email confirmations)
REACT_APP_SITE_URL=http://localhost:3000

# Feature flags
REACT_APP_ENABLE_DEVICE_CONNECT=true
REACT_APP_ENABLE_FORUMS=true
REACT_APP_ENABLE_NOTIFICATIONS=true
